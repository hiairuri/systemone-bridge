# systemone-bridge 配置模板。
# 复制为 config.toml 后按需修改；真实 config.toml 不入库（见 .gitignore）。

[server]
host = "127.0.0.1"
# 18500 为本机约定空闲端口（8000/8001/7999/18000/18660 已被占用）
port = 18500

# 南向 SystemOne（Intern-Decision 决策端点）上游。
# 纯协议转换器：决策失败时北向返回 502 upstream_error，回退由调用方负责。
[upstream_systemone]
# 决策端点的服务根（桥会在其下拼 decisions_path）
base_url = "http://127.0.0.1:8100"
# 决策端点路径：官方开源 serving 为 /v1/decisions；OpenXLab 托管网关为 /v1/systemone
decisions_path = "/v1/decisions"
# 留空则不发 Authorization 头；官方开源 serving 无鉴权，托管网关一般要求 Bearer key
api_key = ""
# 注入请求体顶层的 model 字段（OpenXLab 网关校验必需，如 intern-decision-4b）；
# 留空则不注入，保持官方开源 serving 兼容（官方会忽略未知顶层键）
model = ""
# 一次决策调用的超时秒数（SystemOne 单次前向毫秒级，10s 已极宽裕）
timeout_seconds = 10.0

# 任务解析器开关：关闭后对应任务不识别，北向返回 422 unknown_template
[task_parsers]
# MaiBot 表达方式选择（expression_selector）快照模板
expression_selector = true
# DiceFrame 回合检定规划器（dice_checks 工具调用）
df_check_planner = true
# MaiBot 表达方式入库前审核（expression.check，noul 判定）
expression_check = true
# MaiBot 黑话推断比对（jargon compare，noul 判定）
jargon_compare = true
# MaiBot 表情包替换决策（emoji_replace，choice ≤21 选 1）
emoji_replace = true

[translation]
# exprsel：把 SystemOne 概率分布映射回 selected_ids 的最低入选概率
expression_min_probability = 0.05
# exprsel：最多入选条数（与模板语义"0 到 5 条"一致）
expression_max_selected = 5

[logging]
level = "INFO"
# 相对项目根；data/ 不入库
dir = "data/logs"
